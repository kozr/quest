{
  "name": "iap-notifications",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/functions.js",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local --import tsx --watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env.local dist/server.js",
    "test": "node --import tsx --test test/*.test.ts",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-iap-notifications",
    "test:firebase": "firebase emulators:exec --only auth,firestore --project demo-iap-notifications \"npm test\"",
    "test:all": "firebase emulators:exec --only auth,firestore --project demo-iap-notifications \"npm test && npm run test:browser\"",
    "test:browser": "playwright test",
    "check": "tsc -p tsconfig.json --noEmit",
    "certificates": "node --env-file-if-exists=.env.local --import tsx scripts/fetch-apple-certificates.ts"
  },
  "dependencies": {
    "@apple/app-store-server-library": "^3.1.0",
    "express": "^5.2.1",
    "firebase-admin": "^14.3.0",
    "firebase-functions": "^7.3.2",
    "qrcode": "^1.5.4",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.1",
    "@types/qrcode": "^1.5.6",
    "firebase-tools": "^15.29.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
