# Optional broader web discovery. Keep these empty to use public free sources.
OPENAI_API_KEY=
OPPORTUNITY_OPENAI_MODEL=
# Optional AI profile suggestions; otherwise editable starter suggestions are used.
OPPORTUNITY_SETUP_MODEL=
# Reddit adapter: public-json (default), or redlib through the authenticated OVH bridge.
REDDIT_PROVIDER=
REDLIB_BRIDGE_URL=
REDLIB_BRIDGE_TOKEN=
# The same authenticated gateway also collects LinkedIn posts. No additional
# credential is needed in the tracker. Enable LinkedIn per product in the UI.
# OVH bridge only (private Docker network; never a browser environment variable):
# LINKEDIN_MCP_URL=http://querylane-linkedin-mcp-mcp-1:8080/mcp
# Server-only token for the VPS monitor worker (at least 32 characters).
TRACKER_MONITOR_TOKEN=
# VPS worker only: TRACKER_MONITOR_URL=https://your-tracker.vercel.app
# VPS bridge only: the tracker never reaches this private URL from Vercel.
# REDLIB_BASE_URL=http://127.0.0.1:18080
# Required on Vercel. Use your Firebase project and server-only credentials.
FIREBASE_PROJECT_ID=
FIREBASE_DATABASE_ID=(default)
# Keyless Vercel-to-Firebase connection (recommended):
GCP_WIF_PROVIDER=
GCP_SERVICE_ACCOUNT_EMAIL=
# Optional alternative to keyless authentication. Never expose this to clients.
FIREBASE_SERVICE_ACCOUNT_JSON=
TRACKER_PASSWORD=
TRACKER_SESSION_SECRET=
# TRACKER_WORKSPACE=personal
# TRACKER_PORT=4322
# TRACKER_DATA_DIR=/absolute/path/to/private/tracker-data
