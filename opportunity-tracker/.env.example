# Server-only Luna qualification. Disabled until owner enters the key securely.
# This dedicated name cannot enable unrelated profile/web-search spending.
TRACKER_OPENAI_API_KEY=
TRACKER_AI_ENABLED=false
TRACKER_AI_MODE=ongoing
# Owner-approved aggregate daily cap; values above $2 are rejected.
# Days follow America/Los_Angeles, including daylight-saving changes.
TRACKER_AI_DAILY_BUDGET_USD=2
TRACKER_AI_DAILY_MAX_CALLS=2000
# Optional earlier expiry: TRACKER_AI_BUDGET_UNTIL=ISO_TIMESTAMP
# TRACKER_AI_MODE=test permits only explicit one-post owner checks.
# On-demand Problems, Landscape, People, fit and replies use the same Luna key
# and the same daily budget. No additional API key is required.
# Reddit uses ScrapeBadger; store its key only in the server environment.
REDDIT_PROVIDER=scrapebadger
SCRAPEBADGER_API_KEY=
# LinkedIn keyword post search uses harvestapi/linkedin-post-search on Apify.
# Enable LinkedIn per product in the UI. No LinkedIn session/cookies are needed.
LINKEDIN_PROVIDER=apify
APIFY_TOKEN=
# Optional legacy gateway (REDDIT_PROVIDER=redlib / LINKEDIN_PROVIDER=linkedin-mcp).
REDLIB_BRIDGE_URL=
REDLIB_BRIDGE_TOKEN=
# OVH bridge only (private Docker network; never a browser environment variable):
# LINKEDIN_MCP_URL=http://querylane-linkedin-mcp-mcp-1:8080/mcp
# Server-only token for the VPS monitor worker (at least 32 characters).
TRACKER_MONITOR_TOKEN=
# VPS worker only: TRACKER_MONITOR_URL=https://your-tracker.vercel.app
# VPS bridge only: the tracker never reaches this private URL from Vercel.
# REDLIB_BASE_URL=http://127.0.0.1:18080
# Required on Vercel. Use your Firebase project and server-only credentials.
FIREBASE_PROJECT_ID=
FIREBASE_DATABASE_ID=(default)
# Keyless Vercel-to-Firebase connection (recommended):
GCP_WIF_PROVIDER=
GCP_SERVICE_ACCOUNT_EMAIL=
# Optional alternative to keyless authentication. Never expose this to clients.
FIREBASE_SERVICE_ACCOUNT_JSON=
TRACKER_GOOGLE_CLIENT_ID=
# Comma-separated invited Gmail/Google Workspace accounts for this private workspace.
TRACKER_GOOGLE_ALLOWED_EMAILS=
# Optional stable Google account IDs (required for third-party email accounts).
TRACKER_GOOGLE_ALLOWED_SUBJECTS=
TRACKER_SESSION_SECRET=
# TRACKER_WORKSPACE=personal
# TRACKER_PORT=4322
# TRACKER_DATA_DIR=/absolute/path/to/private/tracker-data
