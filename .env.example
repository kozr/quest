# Copy to .env.local and customize. Never deploy local emulator variables.
NODE_ENV=development
HOST=127.0.0.1
PORT=4317
PUBLIC_URL=http://localhost:4317
FIREBASE_PROJECT_ID=demo-iap-notifications
IAP_FIREBASE_WEB_API_KEY=demo-key
FIRESTORE_EMULATOR_HOST=127.0.0.1:8088
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9098
ALLOW_REGISTRATION=true
ENABLE_DEMO=true
APPLE_ROOT_CERTS_DIR=./certificates

# Optional High-intent leads beta. Both feature gates stay off by default.
LEADS_ENABLED=false
LEADS_AI_ENABLED=false
LEADS_MODEL_ID=gpt-6-luna
# Includes the cache-write premium.
LEADS_INPUT_PRICE_CEILING_USD_PER_MILLION=0.125
LEADS_OUTPUT_PRICE_CEILING_USD_PER_MILLION=0.5
LEADS_AI_GLOBAL_CAP_USD=5
# Includes room for conservative reservations during background search.
LEADS_AI_ACCOUNT_CAP_USD=4
# Set OPENAI_API_KEY only in Firebase Secret Manager; it is conditionally bound
# to processLeadDraft and recoverLeadJobs, never placed in this local env file.

# Optional Market insights beta. Both feature gates stay off by default.
MARKET_ENABLED=false
MARKET_AI_ENABLED=false
# Sol High searches/assesses; Luna Max extracts source-backed details. Shared caps still apply.
MARKET_RESEARCH_PIPELINE=sol-luna
# Market retains the existing access gates and shared monthly AI caps.
# Keep provider secrets in Secret Manager.
# APIFY_TOKEN and OPENAI_API_KEY are never placed in this local env file.
# MARKET_CURSOR_SECRET must be a random secret of at least 32 characters in
# Firebase Secret Manager when Market is enabled; it signs people-page cursors.

# These belong to OUR iPhone companion, not your customers' apps.
# Enable only after the subscription products and verified lifecycle webhook are configured.
# Apply the same values to the API and all marketing workers. See docs/MARKETING_BILLING.md.
MARKETING_BILLING_ENABLED=false
MARKETING_APP_APPLE_ID=
MARKETING_ALLOW_SANDBOX=false

# These belong to OUR iPhone companion, not your customers' apps.
# Set all four to enable actual Apple Push Notification service delivery.
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_TOPIC=
APNS_PRIVATE_KEY_PATH=

# Production: remove BOTH emulator variables. Use a real project + web API key.
# Cloud Functions reads APNS_PRIVATE_KEY from Secret Manager (not a file).
# Never put a service-account JSON key or APNs private key in git.
